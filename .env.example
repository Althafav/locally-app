# Prisma Postgres: the direct postgres:// connection string from the Prisma console
# (Database → Connect). Any Postgres works, e.g. postgresql://user:pass@localhost:5432/locally
DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# Used to sign the session cookie (JWT, HS256). Generate with: openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-string"

# Comma-separated 10-digit mobile numbers that become admins when they log in, e.g. "9876543210,9123456789"
ADMIN_PHONES=""

# Production only: a fixed 6-digit OTP that always works (shown on the login page), for demos
# before real SMS is set up. Anyone can log in as any number while this is set. Development
# always uses 123456. Changing it needs a redeploy (it is built into the client).
# NEXT_PUBLIC_DEMO_OTP="123456"

# console = log OTPs to the server console (dev) | msg91 = send real SMS. twilio is still a stub.
SMS_PROVIDER="console"

# MSG91 (SMS_PROVIDER=msg91): auth key from the MSG91 dashboard, and the id of a
# DLT-approved OTP template that contains ##OTP##
# MSG91_AUTH_KEY=""
# MSG91_TEMPLATE_ID=""
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM=""
