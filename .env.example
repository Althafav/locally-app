# Prisma Postgres: the direct postgres:// connection string from the Prisma console
# (Database → Connect). Any Postgres works, e.g. postgresql://user:pass@localhost:5432/locally
DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# Used to sign the session cookie (JWT, HS256). Generate with: openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-string"

# Comma-separated 10-digit mobile numbers that become admins when they log in, e.g. "9876543210,9123456789"
ADMIN_PHONES=""

# console = log OTPs to the server console (dev). Future: msg91 | twilio
SMS_PROVIDER="console"

# Provider credentials (unused until a real provider is wired up in lib/sms.ts)
# MSG91_AUTH_KEY=""
# MSG91_TEMPLATE_ID=""
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM=""
